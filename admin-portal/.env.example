# Copy to .env (local) or add these in your host's Environment settings (Render / Railway). NEVER commit .env.
NODE_ENV=production
OWNER_PHONE=9677291758
# scrypt hash of the admin password. Make one: npm run hash -- "your password"
ADMIN_PASSWORD_HASH=
# long random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_ENC_KEY=
# MUST be identical to BRIDGE_SECRET in the customer portal
BRIDGE_SECRET=
SESSION_MINUTES=30
# SMS_PROVIDER = fast2sms | msg91 | twilio | console (console = test mode, only outside production)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_TEMPLATE_ID=
FAST2SMS_SENDER_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional permanent storage (orders + OTP history): run supabase/schema.sql first
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
